# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/mern_user_mgmt
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/mern_user_mgmt?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/mern_user_mgmt

# JWT Configuration
# Use a strong, random 256-bit secret in production
JWT_SECRET=super_secret_jwt_key_mern_user_management_2026_secure
JWT_EXPIRE=30d
